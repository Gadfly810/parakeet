{
    "version": "8.5.1",
    "description": "foobox 是一个 foobar2000 默认用户界面 (DUI) 的皮肤配置，具有简洁而美观实用的特点，善于管理曲目数量大的媒体库 ，对音乐各种封面提供丰富的支持",
    "homepage": "https://github.com/dream7180/foobox-cn",
    "license": "GPL-3.0-only",
    "depends": [
        "foobar2000"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/dream7180/foobox-cn/releases/download/8.5.1/foobox_x64.cn.v8.5.1-1.exe#/dl.7z",
        "hash": "0b0a8e07a0fe92c4049ae7a613277e180fde1f220347be98e6ede5096942c045"
        }
    },
    "installer": {
        "script": [
            "# 创建项目根目录的符号链接到 Scoop 安装的 foobar2000",
            "$foobar2000_dir = scoop which foobar2000.exe",
            "",
            "# 创建 foobar2000 的硬链接",
            "if (Test-Path $foobar2000_dir) {",
            "    New-Item -ItemType HardLink -Path \"$dir\\foobar2000.exe\" -Target $foobar2000_dir -Force | Out-Null",
            "}"
        ]
    },
    "persist": "profile",
    "shortcuts": [
        [
            "foobar2000.exe",
            "Foobox"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/dream7180/foobox-cn/releases/latest",
        "regex": "/releases/download/([\\d.]+)/(?<filename>[^/\"]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dream7180/foobox-cn/releases/download/$version/$matchFilename#/dl.7z"
            }
        }
    }
}
