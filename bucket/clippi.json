{
    "version": "0.3.4",
    "description": "Lightweight clipboard manager built with Rust and GPUI",
    "homepage": "https://github.com/Ruszero01/clippi",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Ruszero01/clippi/releases/download/v0.3.4/clippi-x86_64-pc-windows-msvc.zip",
            "hash": "f1378b57fb1cd893334ec156b892bf52c16a92870ca2e4aee24426d7364e1945"
        }
    },
    "pre_install": [
        "if (Test-Path \"$persist_dir\\clippi.db\") { Copy-Item \"$persist_dir\\clippi.db\" \"$dir\\clippi.db\" -Force }",
        "if (Test-Path \"$persist_dir\\clippi.toml\") { Copy-Item \"$persist_dir\\clippi.toml\" \"$dir\\clippi.toml\" -Force }"
    ],
    "post_install": [
        "if (Test-Path \"$dir\\clippi.db\") { Copy-Item \"$dir\\clippi.db\" \"$persist_dir\\clippi.db\" -Force }",
        "if (Test-Path \"$dir\\clippi.toml\") { Copy-Item \"$dir\\clippi.toml\" \"$persist_dir\\clippi.toml\" -Force }"
    ],
    "bin": "clippi.exe",
    "shortcuts": [
        [
            "clippi.exe",
            "Clippi"
        ]
    ],
    "persist": "images",
    "uninstaller": {
        "script": [
            "if (Test-Path \"$dir\\clippi.db\") { Copy-Item \"$dir\\clippi.db\" \"$persist_dir\\clippi.db\" -Force }",
            "if (Test-Path \"$dir\\clippi.toml\") { Copy-Item \"$dir\\clippi.toml\" \"$persist_dir\\clippi.toml\" -Force }"
        ]
    },
    "checkver": {
        "github": "https://github.com/Ruszero01/clippi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Ruszero01/clippi/releases/download/v$version/clippi-x86_64-pc-windows-msvc.zip"
            }
        }
    }
}
